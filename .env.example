# mattermost-mcp — environment configuration. Export these variables or pass
# them in your MCP client config; the server does not load .env automatically.
# Mattermost-specific settings use the MM_ prefix.

# --- Connection (required) ---
MM_URL=https://mattermost.example.com

# --- Auth mode selector: pat | password | oauth2 ---
MM_AUTH_MODE=pat

# pat mode (default, recommended): Personal Access Token using Bearer auth.
# Admins enable tokens in System Console > Integrations > Integration Management.
# Create your token in Profile > Security > Personal Access Tokens.
MM_TOKEN=
# For live PAT rotation in the shared service, configure a private file plus explicit MM_URL.
# MM_TOKEN_FILE=/absolute/path/to/mattermost-pat
# MM_TOKEN_FILE_LINE=1

# password mode: session login. Token expires; auto re-login on 401.
MM_LOGIN_ID=
MM_PASSWORD=
# MFA one-time code, only if the account requires MFA.
MM_MFA_TOKEN=

# oauth2 mode: authorization-code + PKCE + refresh. Register the app in
# System Console > Integrations > OAuth 2.0 Applications.
MM_CLIENT_ID=
MM_CLIENT_SECRET=
# HTTP loopback redirect URI.
MM_OAUTH_REDIRECT=http://127.0.0.1:7000/callback

# --- Guardrails ---
# true → all writes disabled at call time (tools remain listed).
MM_READ_ONLY=false
# true → allow destructive tools (delete_post, archive_channel, remove_member);
# they additionally require confirm:true per call.
MM_ALLOW_DESTRUCTIVE=false
# CSV of team ids; actions outside are refused. Unset = no restriction.
MM_TEAM_ALLOWLIST=
# CSV of channel ids; actions outside are refused. Unset = no restriction.
MM_CHANNEL_ALLOWLIST=
# Reject messages longer than this before sending.
MM_MAX_MESSAGE_LEN=16383

# --- Uploads ---
# JSON array of absolute directories on the MCP server; [] disables local file reads.
# Example: MM_UPLOAD_ROOTS='["/srv/agent-uploads"]'
MM_UPLOAD_ROOTS=[]
# Combined decoded file/binary bytes per call, including inline base64 (100 MiB).
MM_MAX_UPLOAD_BYTES=104857600

# --- Resilience ---
# Per-request timeout in milliseconds; 0 disables it.
MM_REQUEST_TIMEOUT_MS=30000
# Retries apply to safe reads/searches; ambiguous write failures are not retried.
MM_ALLOW_SENSITIVE_READS=false
MM_MAX_RESPONSE_BYTES=8388608
MM_MAX_RETRIES=3
MM_RETRY_BASE_MS=500

# --- Shared HTTP service (serve only) ---
MM_HTTP_PORT=8766
# Set exactly one: an independent random 32+ character bearer, or a private file.
# MM_HTTP_TOKEN=
# MM_HTTP_TOKEN_FILE=/absolute/path/to/http-token
MM_HTTP_MAX_BODY_BYTES=4194304
MM_HTTP_MAX_CONCURRENT=8

# --- Optional private management endpoint (serve only) ---
# A separate random bearer, supplied by private file only. Disabled when unset.
# MM_ADMIN_TOKEN_FILE=/absolute/path/to/admin-token
# MM_SETTINGS_FILE=/absolute/path/to/private/settings.json

# --- Rolling SQLite message cache and opt-in callbacks (serve only) ---
MM_RETENTION_HOURS=48
MM_EVENTS_ENABLED=false
MM_CACHE_VERIFY_POSTS=false
# Optional: permit agent-requested callbacks to sessions on this OpenCode origin.
# MM_OPENCODE_URL=http://127.0.0.1:4096
# MM_OPENCODE_PASSWORD_FILE=/absolute/path/to/opencode-password
# MM_EVENTS_STATE_DIR=/absolute/path/to/private/event-state

# Optional: private JSON file containing exact generic webhook destinations.
# MM_CALLBACK_TARGETS_FILE=/absolute/path/to/allowed-callbacks.json
